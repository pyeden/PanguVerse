#!/bin/sh
# 假 simctl：按 FAKE_SIM_MODE 返回 JSON/命令结果，供无模拟器环境验证解析。
# 支持: normal | empty | fail | notrunning | nostate(405 文本) | json405(405 JSON)
mode="${FAKE_SIM_MODE:-normal}"
if [ -n "$FAKE_SIM_LOG" ]; then
  printf '%s\n' "$*" >> "$FAKE_SIM_LOG"
fi

# 模拟「没有已启动的模拟器」：真机 exit 405 + Unable to lookup；另给 JSON 变体。
if [ "$mode" = "nostate" ] && [ "$1" != "list" ]; then
  echo "An error was encountered processing the command (domain=com.apple.CoreSimulator.SimError, code=405):" >&2
  echo "Unable to lookup in current state: Shutdown" >&2
  exit 405
fi
if [ "$mode" = "json405" ] && [ "$1" != "list" ]; then
  echo '{"error":"Unable to lookup in current state: Shutdown","code":405}'
  exit 1
fi
# 真机形态：设备未启动时 `simctl io screenshot` 报 PNG 编码失败，无 405 码。
if [ "$mode" = "pngfail" ] && [ "$1" = "io" ]; then
  echo "Detected file type 'PNG' from file extension: .png" >&2
  echo "Error creating the image" >&2
  exit 1
fi

case "$1" in
  list)
    case "$mode" in
      empty) cat "${FAKE_SIM_JSON_EMPTY:?not set}" ;;
      fail) echo "simctl: unable to list devices" >&2; exit 1 ;;
      *) cat "${FAKE_SIM_JSON:?not set}" ;;
    esac
    exit 0
    ;;
  launch)
    echo "${3}: 4242"
    exit 0
    ;;
  terminate)
    if [ "$mode" = "notrunning" ]; then
      echo "found nothing to terminate" >&2
      exit 1
    fi
    echo ok
    exit 0
    ;;
  io)
    # io <udid> screenshot <path>
    if [ "$3" = "screenshot" ]; then
      cp "${FAKE_SIM_PNG:?not set}" "$4"
      exit 0
    fi
    echo ok
    exit 0
    ;;
  bootstatus)
    echo ok
    exit 0
    ;;
  boot|shutdown|install|openurl)
    if [ "$mode" = "fail" ]; then
      echo "simctl: operation failed" >&2
      exit 1
    fi
    echo ok
    exit 0
    ;;
esac

echo "unsupported fake simctl command: $*" >&2
exit 2
